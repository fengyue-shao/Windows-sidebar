<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 rescap">

  <Identity
    Name="WindowsSidebar"
    Publisher="CN=WindowsSidebarDev"
    Version="0.8.2.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Windows Sidebar</DisplayName>
    <PublisherDisplayName>Windows Sidebar</PublisherDisplayName>
    <Description>A Qt sidebar for Windows system information and notifications.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en-US" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.28000.0" />
  </Dependencies>

  <Applications>
    <Application
      Id="WindowsSidebar"
      Executable="appqt_rainmeter.exe"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="Windows Sidebar"
        Description="Windows system information and notification sidebar"
        BackgroundColor="transparent"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Square150x150Logo="Assets\Square150x150Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="globalMediaControl" />
    <uap3:Capability Name="userNotificationListener" />
    <DeviceCapability Name="wiFiControl" />
  </Capabilities>
</Package>
